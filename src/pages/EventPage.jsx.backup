import { useState } from 'react';
import { Link, useParams } from 'react-router-dom';
import {
  Mic,
  Briefcase,
  FileText,
  ChevronRight,
  ExternalLink,
  MessageCircle,
  PlayCircle,
  Calendar,
  Video,
  Image,
  MapPin,
  Users,
  Share2,
  Download,
  Clock,
  X,
  Mail,
  Info,
  CheckCircle,
} from 'lucide-react';
import { getEvent } from '../data/eventData';
import PlantPal from '../components/PlantPal';
import Header from '../components/Header';
import MessagingModal from '../components/MessagingModal';

const SECTION_IDS = ['speakers', 'event-details', 'livestream', 'outcomes', 'sessions', 'videos', 'slides', 'photos', 'next-steps', 'sponsors'];

export default function EventPage() {
  const { eventId } = useParams();
  const event = getEvent(eventId);
  const [activeSection, setActiveSection] = useState('about');
  const [selectedSpeaker, setSelectedSpeaker] = useState(null);
  const [showShareToast, setShowShareToast] = useState(false);
  const [messagingRecipient, setMessagingRecipient] = useState(null);
  const [showToast, setShowToast] = useState(false);
  const [toastMessage, setToastMessage] = useState('');

  if (!event) {
    return (
      <div className="min-h-screen bg-dew flex items-center justify-center p-8">
        <div className="text-center">
          <h1 className="text-2xl font-bold text-forest mb-2">Event not found</h1>
          <p className="text-stem mb-4">We couldn’t find an event with that link.</p>
          <Link to="/" className="text-growth font-medium hover:underline">
            Back to home
          </Link>
        </div>
      </div>
    );
  }

  const scrollToSection = (id) => {
    setActiveSection(id);
    document.getElementById(id)?.scrollIntoView({ behavior: 'smooth' });
  };

  const getSpeaker = (speakerId) => event.speakers?.find((s) => s.id === speakerId);

  const handleShare = async () => {
    const url = window.location.href;
    try {
      if (navigator.share) {
        await navigator.share({
          title: event.name,
          text: event.description,
          url: url,
        });
      } else {
        await navigator.clipboard.writeText(url);
        setShowShareToast(true);
        setTimeout(() => setShowShareToast(false), 3000);
      }
    } catch (err) {
      console.error('Error sharing:', err);
    }
  };

  const handleAddToCalendar = () => {
    const eventDate = new Date(event.date);
    const eventTime = event.time?.split(' - ')[0] || '9:00 AM';
    const [hours, minutes] = eventTime.includes('PM') && !eventTime.includes('12')
      ? [parseInt(eventTime.split(':')[0]) + 12, parseInt(eventTime.split(':')[1])]
      : [parseInt(eventTime.split(':')[0]), parseInt(eventTime.split(':')[1])];

    eventDate.setHours(hours, minutes);
    const endDate = new Date(eventDate.getTime() + 2 * 60 * 60 * 1000); // 2 hours later

    const icsContent = `BEGIN:VCALENDAR
VERSION:2.0
BEGIN:VEVENT
DTSTART:${eventDate.toISOString().replace(/[-:]/g, '').split('.')[0]}Z
DTEND:${endDate.toISOString().replace(/[-:]/g, '').split('.')[0]}Z
SUMMARY:${event.name}
DESCRIPTION:${event.description}
LOCATION:${event.location}
END:VEVENT
END:VCALENDAR`;

    const blob = new Blob([icsContent], { type: 'text/calendar' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = `${event.name.replace(/[^a-z0-9]/gi, '_').toLowerCase()}.ics`;
    link.click();
    URL.revokeObjectURL(url);
  };

  const handleGetDirections = () => {
    const query = encodeURIComponent(`${event.location}, ${event.address}`);
    window.open(`https://www.google.com/maps/search/?api=1&query=${query}`, '_blank');
  };

  const handleDownloadResources = () => {
    scrollToSection('videos');
  };

  const showSuccessToast = (message) => {
    setToastMessage(message);
    setShowToast(true);
    setTimeout(() => setShowToast(false), 3000);
  };

  const handleLivestreamRegister = () => {
    showSuccessToast('Successfully registered for livestream! You\'ll receive an email notification.');
  };

  const handleViewPhotos = () => {
    showSuccessToast('Photo gallery coming soon!');
  };

  const handleJoinGroup = (groupName) => {
    showSuccessToast(`Joined ${groupName}! Check your email for details.`);
  };

  return (
    <div className="min-h-screen bg-dew">
      {/* Header */}
      <Header />

      <main className="max-w-7xl mx-auto px-3 sm:px-4 py-3 sm:py-4">
        {/* Hero with About and Speakers */}
        <section className="mb-3 sm:mb-4">
          <div className="grid grid-cols-1 lg:grid-cols-3 gap-4 mb-3">
            {/* Left: Title and About */}
            <div className="lg:col-span-2">
              <div className="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3 mb-2 sm:mb-3">
                <div className="flex-1">
                  <h1 className="text-xl sm:text-2xl md:text-3xl font-bold text-forest mb-1 sm:mb-2">{event.name}</h1>
                  {event.subtitle && (
                    <p className="text-sm sm:text-base text-stem">{event.subtitle}</p>
                  )}
                </div>
                <a
                  href="https://luma.com/ay5c9dw3?tk=fTfMwF"
                  target="_blank"
                  rel="noopener noreferrer"
                  className="bg-gradient-to-r from-growth to-forest text-white px-6 py-3 rounded-lg font-bold text-sm sm:text-base hover:shadow-lg transition-all hover:scale-105 active:scale-95 whitespace-nowrap self-start sm:self-auto text-center"
                >
                  Register Now
                </a>
              </div>

              {/* About moved below title */}
              <div className="card-brand rounded-lg p-3 sm:p-4">
                <p className="text-sm text-stem leading-relaxed">{event.description}</p>
              </div>
            </div>

            {/* Right: Featured Speakers */}
            <div className="lg:col-span-1">
              <div id="speakers" className="card-brand rounded-lg p-3 sm:p-4">
                <h2 className="text-sm sm:text-base font-bold text-forest mb-3 flex items-center gap-2">
                  <Mic className="w-4 h-4 text-growth" />
                  Featured Speakers
                </h2>
                {event.speakers && event.speakers.length > 0 ? (
                  <div className="grid grid-cols-2 gap-2">
                    {event.speakers.map((speaker) => (
                      <button
                        key={speaker.id}
                        onClick={() => setSelectedSpeaker(speaker)}
                        className="border border-mist rounded-lg p-2 hover:border-spring hover:shadow-sm transition-all text-left cursor-pointer group"
                      >
                        <div className="flex flex-col items-center text-center gap-2">
                          <div className="w-12 h-12 bg-gradient-to-br from-leaf to-growth rounded-lg flex items-center justify-center text-white font-bold text-base flex-shrink-0 relative">
                            {speaker.name.charAt(0)}
                            <div className="absolute -top-1 -right-1 w-4 h-4 bg-growth rounded-full flex items-center justify-center">
                              <Info className="w-2.5 h-2.5 text-white" />
                            </div>
                          </div>
                          <div className="w-full">
                            <p className="text-xs font-bold text-forest leading-tight">{speaker.name}</p>
                            <p className="text-xs text-stem mt-0.5">{speaker.company}</p>
                            <p className="text-[10px] text-growth mt-1 font-medium opacity-70 group-hover:opacity-100 transition-opacity">
                              Click for details
                            </p>
                          </div>
                        </div>
                      </button>
                    ))}
                  </div>
                ) : (
                  <p className="text-xs text-stem">No speakers listed</p>
                )}
              </div>
            </div>
          </div>

          {/* Navigation tabs - horizontal scroll on mobile */}
          <nav className="flex items-center gap-1.5 overflow-x-auto pb-2 -mx-3 px-3 sm:mx-0 sm:px-0 sm:flex-wrap">
            {SECTION_IDS.map((id) => (
              <button
                key={id}
                onClick={() => scrollToSection(id)}
                className={`px-3 py-2 rounded-lg text-xs sm:text-sm font-medium transition-colors capitalize whitespace-nowrap flex-shrink-0 ${
                  activeSection === id ? 'bg-spring text-forest' : 'text-stem hover:bg-mist hover:text-forest'
                }`}
              >
                {id}
              </button>
            ))}
          </nav>
        </section>

        <div className="grid grid-cols-1 lg:grid-cols-3 gap-3 sm:gap-4">
          {/* Left column - Outcomes, Sessions, etc */}
          <div className="lg:col-span-2 space-y-3 sm:space-y-4">

            {/* Event Outcomes - What you'll get */}
            <section id="outcomes" className="scroll-mt-16 sm:scroll-mt-20">
              <div className="card-brand rounded-lg p-4 sm:p-5">
                <h2 className="text-lg sm:text-xl font-bold text-forest mb-3">What You'll Get</h2>
                <div className="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
                  <div className="flex items-start gap-3">
                    <div className="w-10 h-10 bg-spring rounded-lg flex items-center justify-center flex-shrink-0">
                      <svg className="w-5 h-5 text-forest" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>
                    </div>
                    <div>
                      <h3 className="text-sm font-bold text-forest mb-1">Session Recordings</h3>
                      <p className="text-xs text-stem">Access all talk recordings & materials</p>
                    </div>
                  </div>
                  <div className="flex items-start gap-3">
                    <div className="w-10 h-10 bg-spring rounded-lg flex items-center justify-center flex-shrink-0">
                      <svg className="w-5 h-5 text-forest" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                      </svg>
                    </div>
                    <div>
                      <h3 className="text-sm font-bold text-forest mb-1">Direct Speaker Access</h3>
                      <p className="text-xs text-stem">Chat with speakers & get answers</p>
                    </div>
                  </div>
                  <div className="flex items-start gap-3">
                    <div className="w-10 h-10 bg-spring rounded-lg flex items-center justify-center flex-shrink-0">
                      <FileText className="w-5 h-5 text-forest" />
                    </div>
                    <div>
                      <h3 className="text-sm font-bold text-forest mb-1">Presentation Slides</h3>
                      <p className="text-xs text-stem">Download all slides & resources</p>
                    </div>
                  </div>
                  <div className="flex items-start gap-3">
                    <div className="w-10 h-10 bg-spring rounded-lg flex items-center justify-center flex-shrink-0">
                      <svg className="w-5 h-5 text-forest" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M13 10V3L4 14h7v7l9-11h-7z" />
                      </svg>
                    </div>
                    <div>
                      <h3 className="text-sm font-bold text-forest mb-1">Follow-up Resources</h3>
                      <p className="text-xs text-stem">Curated learning paths & next steps</p>
                    </div>
                  </div>
                </div>
              </div>
            </section>

            {/* Sessions */}
            <section id="sessions" className="scroll-mt-16 sm:scroll-mt-20">
              <div className="card-brand rounded-lg p-4 sm:p-5">
                <h2 className="text-lg sm:text-xl font-bold text-forest mb-2 sm:mb-3">Sessions</h2>
                <p className="text-xs sm:text-sm text-stem mb-3 sm:mb-4">Click a session to view details</p>
                <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
                  {event.sessions?.map((session) => {
                    const speaker = getSpeaker(session.speakerId);
                    return (
                      <Link
                        key={session.id}
                        to={`/events/${eventId}/sessions/${session.slug}`}
                        className="block border border-mist rounded-lg p-3 hover:border-spring hover:shadow-sm transition-all group h-full"
                      >
                        <div className="flex flex-col h-full">
                          <div className="flex items-center gap-1.5 mb-2">
                            <span className="text-xs font-medium text-stem">
                              {session.time}
                            </span>
                            <span className="px-1.5 py-0.5 rounded-full text-xs font-medium bg-spring text-forest">
                              {session.type}
                            </span>
                          </div>
                          <h3 className="text-sm font-bold text-forest group-hover:text-growth transition-colors leading-tight mb-1">
                            {session.title}
                          </h3>
                          {speaker && (
                            <p className="text-xs text-stem mb-2">
                              {speaker.name}
                            </p>
                          )}

                          {/* Available content icons */}
                          <div className="flex items-center gap-3 mt-auto pt-2 border-t border-mist/50">
                            {session.videoUrl && (
                              <div className="flex items-center gap-1 text-growth" title="Video available">
                                <Video className="w-3.5 h-3.5" />
                                <span className="text-xs">Video</span>
                              </div>
                            )}
                            {session.presentationUrl && (
                              <div className="flex items-center gap-1 text-growth" title="Slides available">
                                <FileText className="w-3.5 h-3.5" />
                                <span className="text-xs">Slides</span>
                              </div>
                            )}
                            {session.photos && session.photos.length > 0 && (
                              <div className="flex items-center gap-1 text-growth" title="Photos available">
                                <Image className="w-3.5 h-3.5" />
                                <span className="text-xs">Photos</span>
                              </div>
                            )}
                          </div>
                        </div>
                      </Link>
                    );
                  })}
                </div>
              </div>
            </section>

            {/* Videos & Slides - Side by side */}
            <section id="videos" className="scroll-mt-16 sm:scroll-mt-20">
              <div className="card-brand rounded-lg p-4 sm:p-5">
                <h2 className="text-lg sm:text-xl font-bold text-forest mb-3">Resources</h2>
                <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                  {/* Videos */}
                  <div id="videos-content">
                    <h3 className="text-sm font-bold text-forest mb-2 flex items-center gap-2">
                      <Video className="w-4 h-4 text-growth" />
                      Videos
                    </h3>
                    {event.videos && event.videos.length > 0 ? (
                      <div className="space-y-2">
                        {event.videos.map((video) => (
                          <a
                            key={video.id}
                            href={video.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            className="group block border border-mist rounded-lg overflow-hidden hover:border-spring transition-all"
                          >
                            <div className="aspect-video bg-gradient-to-br from-soil/5 to-soil/10 relative flex items-center justify-center">
                              {video.thumbnail ? (
                                <img src={video.thumbnail} alt={video.title} className="w-full h-full object-cover" />
                              ) : (
                                <div className="w-10 h-10 bg-forest/10 rounded-full flex items-center justify-center group-hover:bg-forest/20 transition-colors">
                                  <PlayCircle className="w-6 h-6 text-forest" />
                                </div>
                              )}
                            </div>
                            <div className="p-2">
                              <h4 className="text-xs font-bold text-forest group-hover:text-growth transition-colors">{video.title}</h4>
                            </div>
                          </a>
                        ))}
                      </div>
                    ) : (
                      <p className="text-xs text-stem bg-mist rounded-lg p-3 text-center">No videos yet</p>
                    )}
                  </div>

                  {/* Slides */}
                  <div id="slides">
                    <h3 className="text-sm font-bold text-forest mb-2 flex items-center gap-2">
                      <FileText className="w-4 h-4 text-growth" />
                      Slides
                    </h3>
                    {event.presentations && event.presentations.length > 0 ? (
                      <div className="space-y-2">
                        {event.presentations.map((pres) => (
                          <a
                            key={pres.id}
                            href={pres.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            className="group block border border-mist rounded-lg overflow-hidden hover:border-spring transition-all"
                          >
                            <div className="aspect-video bg-gradient-to-br from-spring/10 to-spring/5 relative flex items-center justify-center">
                              {pres.thumbnail ? (
                                <img src={pres.thumbnail} alt={pres.title} className="w-full h-full object-cover" />
                              ) : (
                                <FileText className="w-8 h-8 text-forest/30" />
                              )}
                            </div>
                            <div className="p-2 flex items-center justify-between gap-2">
                              <h4 className="text-xs font-bold text-forest group-hover:text-growth transition-colors flex-1">{pres.title}</h4>
                              <ExternalLink className="w-3 h-3 text-stem group-hover:text-growth flex-shrink-0" />
                            </div>
                          </a>
                        ))}
                      </div>
                    ) : (
                      <p className="text-xs text-stem bg-mist rounded-lg p-3 text-center">No slides yet</p>
                    )}
                  </div>
                </div>
              </div>
            </section>

            {/* Photos */}

            {/* Suggested Events - Next Steps */}
            <section id="next-steps" className="scroll-mt-16 sm:scroll-mt-20">
              <div className="card-brand rounded-lg p-4 sm:p-5">
                <h2 className="text-lg sm:text-xl font-bold text-forest mb-2 sm:mb-3 flex items-center gap-2">
                  <Calendar className="w-4 sm:w-5 h-4 sm:h-5 text-growth" />
                  Continue Your Journey
                </h2>
                <p className="text-xs sm:text-sm text-stem mb-3 sm:mb-4">Suggested events to deepen your learning</p>
                <div className="space-y-3">
                  <div className="border border-mist rounded-lg p-4 hover:border-spring hover:shadow-sm transition-all group cursor-pointer">
                    <div className="flex items-start gap-3">
                      <div className="w-10 h-10 bg-spring rounded-lg flex items-center justify-center flex-shrink-0">
                        <span className="text-sm font-bold text-forest">1</span>
                      </div>
                      <div className="flex-1 min-w-0">
                        <h3 className="text-base font-bold text-forest group-hover:text-growth">Advanced AI Agents Workshop</h3>
                        <p className="text-xs text-stem mt-1">Hands-on deep dive into production AI systems</p>
                        <p className="text-xs text-growth font-medium mt-2">March 15, 2026</p>
                      </div>
                      <ChevronRight className="w-5 h-5 text-stem group-hover:text-growth flex-shrink-0" />
                    </div>
                  </div>
                  <div className="border border-mist rounded-lg p-4 hover:border-spring hover:shadow-sm transition-all group cursor-pointer">
                    <div className="flex items-start gap-3">
                      <div className="w-10 h-10 bg-spring rounded-lg flex items-center justify-center flex-shrink-0">
                        <span className="text-sm font-bold text-forest">2</span>
                      </div>
                      <div className="flex-1 min-w-0">
                        <h3 className="text-base font-bold text-forest group-hover:text-growth">ML Engineering Best Practices</h3>
                        <p className="text-xs text-stem mt-1">Build scalable ML pipelines and deployment strategies</p>
                        <p className="text-xs text-growth font-medium mt-2">April 2, 2026</p>
                      </div>
                      <ChevronRight className="w-5 h-5 text-stem group-hover:text-growth flex-shrink-0" />
                    </div>
                  </div>
                  <div className="border border-mist rounded-lg p-4 hover:border-spring hover:shadow-sm transition-all group cursor-pointer">
                    <div className="flex items-start gap-3">
                      <div className="w-10 h-10 bg-spring rounded-lg flex items-center justify-center flex-shrink-0">
                        <span className="text-sm font-bold text-forest">3</span>
                      </div>
                      <div className="flex-1 min-w-0">
                        <h3 className="text-base font-bold text-forest group-hover:text-growth">AI Safety & Ethics Summit</h3>
                        <p className="text-xs text-stem mt-1">Responsible AI development and governance</p>
                        <p className="text-xs text-growth font-medium mt-2">April 20, 2026</p>
                      </div>
                      <ChevronRight className="w-5 h-5 text-stem group-hover:text-growth flex-shrink-0" />
                    </div>
                  </div>
                </div>
              </div>
            </section>
          </div>

          {/* Right column - Event Details, Quick Actions, Livestream & Sponsors */}
          <div className="space-y-3 sm:space-y-4">
            {/* Event Details */}
            <section id="event-details" className="scroll-mt-16 sm:scroll-mt-20">
              <div className="bg-gradient-to-br from-forest to-growth text-white rounded-lg p-2 sm:p-2.5">
                <div className="space-y-1">
                  <div className="flex items-center gap-2">
                    <Calendar className="w-3.5 h-3.5 flex-shrink-0 opacity-80" />
                    <p className="text-xs font-medium">{event.date}</p>
                  </div>
                  <div className="flex items-center gap-2">
                    <Clock className="w-3.5 h-3.5 flex-shrink-0 opacity-80" />
                    <p className="text-xs font-medium">{event.time}</p>
                  </div>
                  <div className="flex items-center gap-2">
                    <MapPin className="w-3.5 h-3.5 flex-shrink-0 opacity-80" />
                    <p className="text-xs font-medium">{event.location}</p>
                  </div>
                  <div className="flex items-center gap-2">
                    <Users className="w-3.5 h-3.5 flex-shrink-0 opacity-80" />
                    <p className="text-xs font-medium">247 attending</p>
                  </div>
                </div>
              </div>
            </section>

            {/* Quick Actions */}
            <div className="card-brand rounded-lg p-4">
              <h3 className="text-sm font-bold text-forest mb-3">Quick Actions</h3>
              <div className="grid grid-cols-2 gap-2">
                <button
                  onClick={handleShare}
                  className="flex items-center justify-center gap-2 px-3 py-2.5 bg-spring text-forest rounded-lg text-xs font-medium hover:from-growth hover:to-autumn hover:text-white transition-all active:scale-95"
                >
                  <Share2 className="w-4 h-4" />
                  Share
                </button>
                <button
                  onClick={handleAddToCalendar}
                  className="flex items-center justify-center gap-2 px-3 py-2.5 bg-spring text-forest rounded-lg text-xs font-medium hover:from-growth hover:to-autumn hover:text-white transition-all active:scale-95"
                >
                  <Calendar className="w-4 h-4" />
                  Add to Cal
                </button>
                <button
                  onClick={handleDownloadResources}
                  className="flex items-center justify-center gap-2 px-3 py-2.5 bg-spring text-forest rounded-lg text-xs font-medium hover:from-growth hover:to-autumn hover:text-white transition-all active:scale-95"
                >
                  <Download className="w-4 h-4" />
                  Resources
                </button>
                <button
                  onClick={handleGetDirections}
                  className="flex items-center justify-center gap-2 px-3 py-2.5 bg-spring text-forest rounded-lg text-xs font-medium hover:from-growth hover:to-autumn hover:text-white transition-all active:scale-95"
                >
                  <MapPin className="w-4 h-4" />
                  Directions
                </button>
              </div>

              {/* Share confirmation toast */}
              {showShareToast && (
                <div className="mt-3 px-3 py-2 bg-gradient-to-r from-leaf to-growth text-white text-xs rounded-lg text-center animate-grow-in">
                  Link copied to clipboard!
                </div>
              )}
            </div>

            {/* Livestream */}
            <section id="livestream" className="scroll-mt-16 sm:scroll-mt-20">
              <div className="card-brand rounded-lg p-4 sm:p-5">
                <h2 className="text-lg sm:text-xl font-bold text-forest mb-2 sm:mb-3 flex items-center gap-2">
                  <svg className="w-5 h-5 text-growth" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                  </svg>
                  Livestream
                </h2>
                <div className="border border-mist rounded-lg overflow-hidden bg-soil/5">
                  <div className="aspect-video flex items-center justify-center">
                    <div className="text-center p-6">
                      <div className="w-12 h-12 bg-autumn/20 rounded-full flex items-center justify-center mx-auto mb-3">
                        <div className="w-3 h-3 bg-autumn rounded-full animate-pulse"></div>
                      </div>
                      <p className="text-sm font-medium text-forest mb-1">Event Livestream</p>
                      <p className="text-xs text-stem mb-2">Stream will start at event time</p>
                    </div>
                  </div>
                </div>
                <button
                  onClick={handleLivestreamRegister}
                  className="w-full mt-2 sm:mt-3 bg-gradient-to-r from-growth to-forest text-white py-3 px-4 rounded-lg font-medium text-sm hover:shadow-md transition-all flex items-center justify-center gap-2 active:scale-95"
                >
                  <PlayCircle className="w-4 h-4" />
                  Register for Livestream
                </button>
                <p className="text-xs text-stem text-center mt-2">Get notified when we go live</p>
              </div>
            </section>

            {/* Photos - Compact */}
            <section id="photos" className="scroll-mt-16 sm:scroll-mt-20">
              <div className="card-brand rounded-lg p-3">
                <h3 className="text-sm font-bold text-forest mb-2 flex items-center gap-2">
                  <Image className="w-3.5 h-3.5 text-growth" />
                  Photos
                </h3>
                <div className="grid grid-cols-2 gap-1.5">
                  {[1, 2].map((i) => (
                    <div
                      key={i}
                      className="aspect-square bg-gradient-to-br from-spring/20 to-leaf/20 rounded overflow-hidden border border-mist hover:border-growth cursor-pointer transition-all group"
                    >
                      <div className="w-full h-full flex items-center justify-center">
                        <Image className="w-4 h-4 text-forest/30 group-hover:text-forest/50 transition-colors" />
                      </div>
                    </div>
                  ))}
                </div>
                <button
                  onClick={handleViewPhotos}
                  className="w-full border border-mist text-forest py-1.5 px-2 rounded mt-2 text-xs font-medium hover:border-growth hover:bg-mist transition-all"
                >
                  View All
                </button>
              </div>
            </section>

            {/* Sponsors */}
            <section id="sponsors" className="scroll-mt-16 sm:scroll-mt-20">
              <div className="card-brand rounded-lg p-4 sm:p-5">
                <h2 className="text-lg sm:text-xl font-bold text-forest mb-2 sm:mb-3">Sponsors</h2>
                {event.sponsors && event.sponsors.length > 0 ? (
                  <div className="space-y-3">
                    {event.sponsors.map((sponsor) => (
                      <div
                        key={sponsor.id}
                        className="border border-mist rounded-lg p-3 flex items-center gap-3"
                      >
                        <Briefcase className="w-6 h-6 text-growth flex-shrink-0" />
                        <div className="min-w-0">
                          <p className="text-base font-bold text-forest">{sponsor.name}</p>
                          <p className="text-sm text-stem">{sponsor.tier}</p>
                        </div>
                      </div>
                    ))}
                  </div>
                ) : (
                  <p className="text-sm text-stem">No sponsors listed</p>
                )}
              </div>
            </section>
          </div>
        </div>
      </main>

      <footer className="border-t border-mist bg-white mt-4 sm:mt-6 py-4">
        <div className="max-w-7xl mx-auto px-3 sm:px-4 text-center">
          <Link to="/" className="text-sm font-medium text-forest hover:text-growth">
            digo
          </Link>
        </div>
      </footer>

      {/* Speaker Modal */}
      {selectedSpeaker && (
        <div className="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4" onClick={() => setSelectedSpeaker(null)}>
          <div className="bg-white rounded-xl max-w-md w-full p-6 animate-grow-in" onClick={(e) => e.stopPropagation()}>
            {/* Close button */}
            <button
              onClick={() => setSelectedSpeaker(null)}
              className="absolute top-4 right-4 p-2 text-stem hover:text-forest transition-colors"
              aria-label="Close"
            >
              <X className="w-5 h-5" />
            </button>

            {/* Speaker info */}
            <div className="flex items-start gap-4 mb-6">
              <div className="w-16 h-16 bg-gradient-to-br from-leaf to-growth rounded-xl flex items-center justify-center text-white font-bold text-2xl flex-shrink-0">
                {selectedSpeaker.name.charAt(0)}
              </div>
              <div className="flex-1 min-w-0">
                <h3 className="text-xl font-bold text-forest mb-1">{selectedSpeaker.name}</h3>
                <p className="text-sm text-stem">{selectedSpeaker.company}</p>
                <p className="text-sm text-growth font-medium mt-1">{selectedSpeaker.topic}</p>
              </div>
            </div>

            {/* Contact info */}
            <div className="space-y-3 mb-6">
              <h4 className="text-sm font-bold text-forest">Contact Information</h4>
              <div className="space-y-2">
                {selectedSpeaker.email && (
                  <a
                    href={`mailto:${selectedSpeaker.email}`}
                    className="flex items-center gap-2 text-sm text-stem hover:text-growth transition-colors"
                  >
                    <Mail className="w-4 h-4" />
                    {selectedSpeaker.email}
                  </a>
                )}
                {selectedSpeaker.twitter && (
                  <a
                    href={`https://twitter.com/${selectedSpeaker.twitter}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    className="flex items-center gap-2 text-sm text-stem hover:text-growth transition-colors"
                  >
                    <ExternalLink className="w-4 h-4" />
                    @{selectedSpeaker.twitter}
                  </a>
                )}
                {selectedSpeaker.linkedin && (
                  <a
                    href={selectedSpeaker.linkedin}
                    target="_blank"
                    rel="noopener noreferrer"
                    className="flex items-center gap-2 text-sm text-stem hover:text-growth transition-colors"
                  >
                    <ExternalLink className="w-4 h-4" />
                    LinkedIn Profile
                  </a>
                )}
              </div>
            </div>

            {/* Message button */}
            <button
              onClick={() => {
                setMessagingRecipient(selectedSpeaker);
                setSelectedSpeaker(null);
              }}
              className="w-full bg-gradient-to-r from-growth to-forest text-white py-3 px-4 rounded-lg font-medium text-sm hover:shadow-md transition-all flex items-center justify-center gap-2 active:scale-95"
            >
              <MessageCircle className="w-4 h-4" />
              Message {selectedSpeaker.name.split(' ')[0]}
            </button>
          </div>
        </div>
      )}

      {/* Messaging Modal */}
      {messagingRecipient && (
        <MessagingModal
          recipient={messagingRecipient}
          onClose={() => setMessagingRecipient(null)}
        />
      )}

      {/* Global Success Toast */}
      {showToast && (
        <div className="fixed bottom-4 left-1/2 transform -translate-x-1/2 z-50 animate-grow-in">
          <div className="bg-gradient-to-r from-growth to-forest text-white px-6 py-3 rounded-lg shadow-lg flex items-center gap-2">
            <CheckCircle className="w-5 h-5" />
            <p className="text-sm font-medium">{toastMessage}</p>
          </div>
        </div>
      )}

      {/* Plant Pal Assistant */}
      <PlantPal />
    </div>
  );
}
